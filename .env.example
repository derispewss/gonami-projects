# ================================================================
# DATABASE
# ================================================================
DATABASE_URL=postgres://finwa:finwa_secret@localhost:5432/finwa?sslmode=disable

# ================================================================
# WHATSAPP DEVICE STORE (SQLite, dipisah dari PostgreSQL)
# ================================================================
WHATSAPP_DB_PATH=./data/whatsapp.db
WHATSAPP_CONFIRM_BUTTONS=false

# ================================================================
# OBJECT STORAGE (MinIO / S3-Compatible / lokal)
# ================================================================
# Development (make dev-up) & produksi (make up): OTOMATIS pakai "minio"
# via docker-compose — nilai di bawah dioverride dan endpoint mengarah
# ke service minio. Variabel ini hanya relevan jika menjalankan bot
# manual di luar Docker.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/media
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=gonami
STORAGE_USE_SSL=false

# ================================================================
# GOOGLE GEMINI
# ================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# Model murah khusus fallback teks layer-2 (kosongkan = pakai GEMINI_MODEL)
GEMINI_MODEL_TEXT=

# ================================================================
# GROQ (Cadangan / Fallback saat Gemini limit/error)
# ================================================================
# Opsional. Jika diisi, bot otomatis beralih ke Groq ketika Gemini
# menolak (quota 429 / budget habis) untuk teks & voice note.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ================================================================
# TOKEN SAVER (hemat kuota LLM)
# ================================================================
# Maks panggilan LLM per hari WIB (circuit breaker anti-spam). 0 = unlimited
LLM_DAILY_BUDGET=300
# Batas token output per panggilan ekstraksi teks
LLM_MAX_OUTPUT_TOKENS=150

# ================================================================
# APP BEHAVIOR
# ================================================================
APP_ENV=development
LOG_LEVEL=info

# File size limits (MB)
MAX_AUDIO_SIZE_MB=10
MAX_IMAGE_SIZE_MB=10
MAX_PDF_SIZE_MB=20

# Draft expiry
DRAFT_EXPIRY_MINUTES=15

# Confidence thresholds
CONFIDENCE_AUTO_SAVE=0.80
CONFIDENCE_ASK_CONFIRM=0.50
